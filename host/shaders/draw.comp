#version 460
#extension GL_EXT_buffer_reference : require

// One invocation per screen pixel. Walks the nodes from the top, blending each layer under
// the ones above it, and stops at the first opaque one. Layouts match DrawFrame and DrawNode in
// draw.c, cells and styles match sc2.h, glyph keys match host.h.

layout(local_size_x = 8, local_size_y = 8) in;

const uint NODE_CELLS     = 1u;  // sc2.h
const uint NODE_PIXELS    = 2u;
const uint CODEPOINT_MASK   = 0x1fffffu;
const uint STYLE_SHIFT      = 21u;
const uint STYLE_MASK       = 1023u;
const uint WIDE_BIT         = 1u << 31;
const uint GLYPH_BOLD       = 1u << 21;
const uint GLYPH_ITALIC     = 1u << 22;
const uint GLYPH_LEFT_HALF  = 1u << 23;
const uint GLYPH_RIGHT_HALF = 1u << 24;
const uint NO_SLOT        = 0xffffffffu;
const uint MISS_PROBES    = 8u;  // a crowded miss table drops the key; the next frame records it

layout(buffer_reference, std430) readonly buffer Cells { uint cells[]; };
layout(buffer_reference, std430) readonly buffer Coverage { uint words[]; };     // a byte per pixel, 4 per word
layout(buffer_reference, std430) readonly buffer GlyphTable { uint entries[]; }; // key, slot pairs
layout(buffer_reference, std430) buffer MissTable { uint keys[]; };
layout(buffer_reference, std430) readonly buffer Pixels { uint words[]; };      // RGBA bytes, straight alpha
layout(buffer_reference, std430) buffer SlotFrames { uint frames[]; };  // the last frame that drew each slot
layout(buffer_reference, std430) readonly buffer Styles { uint words[]; };  // foreground, background, then bold, italic, underline bytes

struct Node {
    int  clip_left, clip_top, clip_right, clip_bottom;
    int  content_left, content_top;
    uint kind;
    uint storage_offset;
    uint content_width, content_height;
    uint area_width, area_height;
};

layout(buffer_reference, std430) readonly buffer Frame {
    Cells      cells;
    Coverage   coverage;
    GlyphTable glyph_table;
    MissTable  miss_table;
    SlotFrames slot_frames;
    Pixels     pixels;
    Styles     styles;
    uint background;
    uint cell_width, cell_height;
    uint underline_top, underline_thickness;
    uint glyph_table_mask, miss_table_mask;
    uint node_count;
    uint frame_number;
    Node nodes[];
};

layout(set = 0, binding = 0) writeonly uniform image2D target;
layout(push_constant) uniform Push { Frame frame; };

vec4 color_of(uint rgba) {
    return vec4(rgba >> 24, (rgba >> 16) & 255u, (rgba >> 8) & 255u, rgba & 255u) / 255.0;
}

uint glyph_hash(uint key) {
    return key * 2654435761u;
}

// Each missing glyph goes in once. Plain reads first: most pixels find their key already there.
void record_miss(uint key) {
    uint index = glyph_hash(key) & frame.miss_table_mask;
    for (uint probe = 0u; probe < MISS_PROBES; probe++) {
        uint entry_key = frame.miss_table.keys[index];
        if (entry_key == key)
            return;
        if (entry_key == 0u) {
            uint previous = atomicCompSwap(frame.miss_table.keys[index], 0u, key);
            if (previous == 0u || previous == key)
                return;
        }
        index = (index + 1u) & frame.miss_table_mask;
    }
}

uint glyph_slot(uint key) {
    uint index = glyph_hash(key) & frame.glyph_table_mask;
    while (true) {
        uint entry_key = frame.glyph_table.entries[index * 2u];
        if (entry_key == key)
            return frame.glyph_table.entries[index * 2u + 1u];
        if (entry_key == 0u)
            return NO_SLOT;
        index = (index + 1u) & frame.glyph_table_mask;
    }
}

// inside: the pixel within the cell. drawn: the glyph key bits besides the codepoint.
float glyph_coverage(uint cell, uint drawn, uvec2 inside) {
    uint codepoint = cell & CODEPOINT_MASK;
    if (codepoint <= 32u)  // controls and space draw nothing
        return 0.0;
    uint key = codepoint | drawn;
    uint slot = glyph_slot(key);
    if (slot == NO_SLOT) {
        record_miss(key);
        return 0.0;
    }
    if (frame.slot_frames.frames[slot] != frame.frame_number)
        frame.slot_frames.frames[slot] = frame.frame_number;
    uint byte_index = (slot * frame.cell_height + inside.y) * frame.cell_width + inside.x;
    return float((frame.coverage.words[byte_index >> 2] >> ((byte_index & 3u) * 8u)) & 255u) / 255.0;
}

// Premultiplied color and alpha. Outside the grid is transparent.
vec4 cell_layer(Node node, ivec2 pixel) {
    ivec2 offset = pixel - ivec2(node.content_left, node.content_top);
    if (offset.x < 0 || offset.y < 0)
        return vec4(0.0);
    uvec2 cell_size = uvec2(frame.cell_width, frame.cell_height);
    uvec2 position = uvec2(offset) / cell_size;  // column, row
    if (position.x >= node.content_width || position.y >= node.content_height)
        return vec4(0.0);
    uint row_start = node.storage_offset + position.y * node.content_width;
    uint cell = frame.cells.cells[row_start + position.x];
    uint drawn = (cell & WIDE_BIT) != 0u ? GLYPH_LEFT_HALF : 0u;
    if (position.x > 0u && (frame.cells.cells[row_start + position.x - 1u] & WIDE_BIT) != 0u) {
        cell = frame.cells.cells[row_start + position.x - 1u];  // the right half of the wide cell before
        drawn = GLYPH_RIGHT_HALF;
    }
    uvec2 inside = uvec2(offset) - position * cell_size;

    uint style = ((cell >> STYLE_SHIFT) & STYLE_MASK) * 3u;
    uint attributes = frame.styles.words[style + 2u];
    if ((attributes & 0xffu) != 0u)
        drawn |= GLYPH_BOLD;
    if ((attributes & 0xff00u) != 0u)
        drawn |= GLYPH_ITALIC;
    float coverage = glyph_coverage(cell, drawn, inside);
    if ((attributes & 0xff0000u) != 0u && inside.y >= frame.underline_top
        && inside.y < frame.underline_top + frame.underline_thickness)
        coverage = 1.0;
    vec4 foreground = color_of(frame.styles.words[style]);
    vec4 background = color_of(frame.styles.words[style + 1u]);
    float ink = foreground.a * coverage;
    return vec4(foreground.rgb * ink, ink) + vec4(background.rgb * background.a, background.a) * (1.0 - ink);
}

// Premultiplied, so filtering never pulls color out of transparent pixels.
vec4 texel(Node node, uvec2 position) {
    vec4 color = unpackUnorm4x8(frame.pixels.words[node.storage_offset / 4u + position.y * node.content_width + position.x]);
    return vec4(color.rgb * color.a, color.a);
}

// The image stretched over the node's area, filtered bilinearly.
vec4 pixel_layer(Node node, ivec2 pixel) {
    vec2 image_size = vec2(node.content_width, node.content_height);
    vec2 offset = vec2(pixel - ivec2(node.content_left, node.content_top)) + 0.5;
    vec2 position = clamp(offset * image_size / vec2(node.area_width, node.area_height) - 0.5, vec2(0.0), image_size - 1.0);
    uvec2 low = uvec2(position);
    uvec2 high = min(low + 1u, uvec2(image_size) - 1u);
    vec2 weight = position - vec2(low);
    vec4 top = mix(texel(node, low), texel(node, uvec2(high.x, low.y)), weight.x);
    vec4 bottom = mix(texel(node, uvec2(low.x, high.y)), texel(node, high), weight.x);
    return mix(top, bottom, weight.y);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(target))))
        return;
    vec3 color = vec3(0.0);  // premultiplied, from the layers above
    float shown = 1.0;       // how much of the layers below still shows
    for (int index = int(frame.node_count) - 1; index >= 0 && shown > 0.0; index--) {
        Node node = frame.nodes[index];
        if ((node.kind != NODE_CELLS && node.kind != NODE_PIXELS) || pixel.x < node.clip_left || pixel.x >= node.clip_right
            || pixel.y < node.clip_top || pixel.y >= node.clip_bottom)
            continue;
        vec4 layer = node.kind == NODE_CELLS ? cell_layer(node, pixel) : pixel_layer(node, pixel);
        color += shown * layer.rgb;
        shown *= 1.0 - layer.a;
    }
    color += shown * color_of(frame.background).rgb;
    imageStore(target, pixel, vec4(color, 1.0));
}
